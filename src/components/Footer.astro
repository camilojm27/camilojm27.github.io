---
import type { Lang } from '../i18n/translations';
import { t } from '../i18n/translations';

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
---

<footer class="site">
	<span>© {new Date().getFullYear()} Camilo Mezú Mina</span>
	<span data-en={t('en', 'footer_made')} data-es={t('es', 'footer_made')}>
		{t(lang, 'footer_made')}
	</span>
</footer>

<style>
	.site {
		font-family: 'VT323', monospace;
		font-size: 1.1rem;
		color: var(--ink-soft);
		letter-spacing: 0.02em;
		max-width: 640px;
		margin: 64px auto 0;
		padding: 18px 28px 48px;
		border-top: 1px solid var(--rule);
		display: flex;
		justify-content: space-between;
		gap: 12px;
		flex-wrap: wrap;
	}
	@media (max-width: 520px) {
		.site { padding: 16px 20px 36px; }
	}
</style>
