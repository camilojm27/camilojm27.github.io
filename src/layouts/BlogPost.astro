---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { t } from '../i18n/translations';

type Props = CollectionEntry<'blog'>['data'];

const lang = 'en';
const { title, description, pubDate, updatedDate } = Astro.props;
---

<html lang="en">
<head>
	<BaseHead title={title} description={description} />
</head>
<body>
	<Header lang={lang} activePage="blog" />
	<main>
		<article>
			<div class="post-header">
				<p class="post-date">
					<FormattedDate date={pubDate} />
					{updatedDate && (
						<span class="updated"> · updated <FormattedDate date={updatedDate} /></span>
					)}
				</p>
				<h1>{title}</h1>
				<hr />
			</div>
			<div class="prose">
				<slot />
			</div>
			<div class="post-footer">
				<a href="/blog/" data-en={t('en','back_to_blog')} data-es={t('es','back_to_blog')}>
					{t(lang,'back_to_blog')}
				</a>
			</div>
		</article>
	</main>
	<Footer lang={lang} />
</body>
</html>

<style>
	main {
		max-width: 640px;
		margin: 0 auto;
		padding: 0 28px;
	}
	.post-header { margin-bottom: 24px; }
	.post-date { color: var(--ink-soft); font-size: 0.9rem; margin: 0 0 8px; }
	.updated { font-style: italic; }
	.post-header h1 { margin-bottom: 16px; }
	.prose { line-height: 1.75; }
	.prose p { margin-bottom: 1.1em; }
	.post-footer {
		margin-top: 48px;
		padding-top: 20px;
		border-top: 1px solid var(--rule);
	}
	@media (max-width: 520px) {
		main { padding: 0 20px; }
	}
</style>
