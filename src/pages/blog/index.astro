---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { t } from '../../i18n/translations';

const lang = 'en';
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
<head>
	<BaseHead title={t(lang,'blog_heading')} description={t(lang,'blog_sub')} />
</head>
<body>
	<Header lang={lang} activePage="blog" />

	<main>
		<h1 data-en={t('en','blog_heading')} data-es={t('es','blog_heading')}>{t(lang,'blog_heading')}</h1>
		<p class="muted" data-en={t('en','blog_sub')} data-es={t('es','blog_sub')}>{t(lang,'blog_sub')}</p>

		<ul class="post-list">
			{posts.map((post) => (
				<li>
					<a href={`/blog/${post.id}/`}>
						<span class="post-title">{post.data.title}</span>
						<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
					</a>
				</li>
			))}
		</ul>
	</main>

	<Footer lang={lang} />
</body>
</html>

<style>
	main {
		max-width: 640px;
		margin: 0 auto;
		padding: 0 28px;
	}
	.post-list {
		list-style: none;
		padding: 0;
		margin: 24px 0 0;
	}
	.post-list li {
		border-bottom: 1px dashed var(--rule);
	}
	.post-list li:last-child { border-bottom: none; }
	.post-list a {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 16px;
		padding: 10px 0;
		text-decoration: none;
		color: var(--ink);
		flex-wrap: wrap;
	}
	.post-list a:hover .post-title { color: var(--accent); }
	.post-title { font-weight: 500; }
	.post-date { font-size: 0.85rem; color: var(--ink-soft); white-space: nowrap; }
	@media (max-width: 520px) {
		main { padding: 0 20px; }
	}
</style>
