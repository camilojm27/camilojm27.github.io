---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { t } from '../../i18n/translations';

const lang = 'en';
---

<!doctype html>
<html lang="en">
<head>
	<BaseHead title={t(lang,'projects')} description={t(lang,'projects_sub')} />
</head>
<body>
	<Header lang={lang} activePage="projects" />

	<main>
		<h1 data-en={t('en','projects_heading')} data-es={t('es','projects_heading')}>{t(lang,'projects_heading')}</h1>
		<p class="muted" data-en={t('en','projects_sub')} data-es={t('es','projects_sub')}>{t(lang,'projects_sub')}</p>

		<article class="project">
			<h3>AdvizorPro</h3>
			<div class="meta" data-en="Full-Stack Developer · 2025 – present" data-es="Desarrollador Full-Stack · 2025 – actualidad">Full-Stack Developer · 2025 – present</div>
			<p data-en="Building features across the product for a data platform serving financial advisors. Day-to-day: designing APIs, writing frontend and backend, shipping to production." data-es="Desarrollo funcionalidades en toda la plataforma, una herramienta de datos para asesores financieros. Mi día a día: diseñar APIs, escribir frontend y backend, y llevar cambios a producción.">Building features across the product for a data platform serving financial advisors. Day-to-day: designing APIs, writing frontend and backend, shipping to production.</p>
		</article>

		<article class="project">
			<h3 data-en="Events mobile app — ATD" data-es="App móvil de eventos — ATD">Events mobile app — ATD</h3>
			<div class="meta" data-en="Mobile Developer · 2024 – 2025" data-es="Desarrollador móvil · 2024 – 2025">Mobile Developer · 2024 – 2025</div>
			<p data-en="Led the design, development and release of a cross-platform app (iOS + Android) that replaced a WooCommerce site for selling event tickets. Built a backend layer in front of the legacy store to tighten security, add push notifications, and improve the purchase flow." data-es="Lideré el diseño, desarrollo y publicación de una app multiplataforma (iOS + Android) que reemplazó un sitio WooCommerce para la venta de boletería de eventos. Construí una capa de backend frente a la tienda existente para reforzar la seguridad, agregar notificaciones push y mejorar el flujo de compra.">Led the design, development and release of a cross-platform app (iOS + Android) that replaced a WooCommerce site for selling event tickets. Built a backend layer in front of the legacy store to tighten security, add push notifications, and improve the purchase flow.</p>
		</article>

		<article class="project">
			<h3 data-en="Docker management platform — undergraduate thesis" data-es="Plataforma de gestión de Docker — tesis de pregrado">Docker management platform — undergraduate thesis</h3>
			<div class="meta" data-en="Thesis · 2023 – 2024" data-es="Tesis · 2023 – 2024">Thesis · 2023 – 2024</div>
			<p data-en="A self-hosted platform to manage Docker containers across machines through a message-based agent architecture. Earned the degree with it." data-es="Una plataforma auto-alojada para gestionar contenedores Docker en varias máquinas a través de una arquitectura de agentes basada en mensajería. Con este trabajo obtuve el título.">A self-hosted platform to manage Docker containers across machines through a message-based agent architecture. Earned the degree with it.</p>
		</article>

		<article class="project">
			<h3 data-en="Moodle platform — Universidad del Valle" data-es="Plataforma Moodle — Universidad del Valle">Moodle platform — Universidad del Valle</h3>
			<div class="meta" data-en="Software Engineer · 2021 – 2023" data-es="Ingeniero de software · 2021 – 2023">Software Engineer · 2021 – 2023</div>
			<p data-en="Kept the university's learning platform alive for thousands of students. Reviewed, customized and maintained plugins; handled the Oracle Linux servers underneath — SELinux, Apache, PHP, cron, Redis, PostgreSQL." data-es="Mantuve la plataforma de aprendizaje de la universidad funcionando para miles de estudiantes. Revisé, personalicé y mantuve plugins; también administré los servidores Oracle Linux por debajo — SELinux, Apache, PHP, cron, Redis, PostgreSQL.">Kept the university's learning platform alive for thousands of students. Reviewed, customized and maintained plugins; handled the Oracle Linux servers underneath — SELinux, Apache, PHP, cron, Redis, PostgreSQL.</p>
		</article>

		<article class="project">
			<h3 data-en="Books & authors web app — Humanities Faculty" data-es="Aplicación web de libros y autores — Facultad de Humanidades">Books &amp; authors web app — Humanities Faculty</h3>
			<div class="meta" data-en="Full-stack developer · 2022" data-es="Desarrollador full-stack · 2022">Full-stack developer · 2022</div>
			<p data-en="Web application to manage the faculty's editorial catalogue and pull author biographies from the national CvLac registry." data-es="Aplicación web para gestionar el catálogo editorial de la facultad y consultar hojas de vida de autores desde el registro nacional CvLac.">Web application to manage the faculty's editorial catalogue and pull author biographies from the national CvLac registry.</p>
		</article>

		<hr />
		<p class="muted"><a href="/" data-en={t('en','back_home')} data-es={t('es','back_home')}>{t(lang,'back_home')}</a></p>
	</main>

	<Footer lang={lang} />
</body>
</html>

<style>
	main {
		max-width: 640px;
		margin: 0 auto;
		padding: 0 28px;
	}
	.project {
		padding: 18px 0;
		border-bottom: 1px solid var(--rule);
	}
	.project:last-of-type { border-bottom: none; }
	.project h3 { font-size: 1rem; font-weight: 600; margin: 0 0 4px; }
	.project p { margin: 8px 0 0; }
	.meta { font-size: 0.85rem; color: var(--ink-soft); }
	@media (max-width: 520px) {
		main { padding: 0 20px; }
	}
</style>
